# Importing necessary libraries
import numpy as np
import pandas as pd
# 1. List
marks = [85, 90, 78, 88]
print("List of Marks:", marks)
# 2. Array
arr = np.array([1, 2, 3, 4, 5])
print("\nArray Elements:", arr)
# 3. DataFrame
data = {
'Name': ['Ram', 'Sita', 'Ravi'],
'Marks': [85, 92, 78]
}
df = pd.DataFrame(data)
print("\nDataFrame:\n", df)
# 4. Matrix
matrix = np.array([[1, 2], [3, 4]])
print("\nMatrix:\n", matrix)

